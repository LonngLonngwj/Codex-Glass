# Generated application and cached upstream source archives are distributed in Releases.
/app/
/dependency-sources/*
!/dependency-sources/manifest.json
/installers/
/build/
/dist/
*.spec

# Development caches and private runtime files.
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
settings-v2.json*
settings.json
diagnostic*.json
*.partial
*.log
*.tmp
.DS_Store
Thumbs.db

# Generated binaries belong in Release assets, not Git history.
*.exe
*.dll
*.zip
